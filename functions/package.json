{
  "name": "quest-functions",
  "version": "1.0.0",
  "description": "Cloud Functions QUEST : quest engine, XP, QuestCheck",
  "main": "lib/index.js",
  "type": "commonjs",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage",
    "emulators": "firebase emulators:start --only functions,firestore,auth,storage",
    "test": "tsc -p tsconfig.test.json && node --test \"lib-test/test/**/*.test.js\"",
    "lint": "tsc --noEmit",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.6.0",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.20.0",
    "firebase": "^12.19.0",
    "typescript": "^5.9.3"
  },
  "private": true
}
